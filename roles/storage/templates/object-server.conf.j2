[DEFAULT]
devices = /srv/node
bind_ip = {{ ansible_ens8.ipv4.address }}
bind_port = 6000
# bind_port = 8080
{% if swift_backend is defined and swift_backend == 'bs_bind' %}
servers_per_port = 1
{% else %}
workers = 2
{% endif %}

[pipeline:main]
pipeline = object-server

[app:object-server]
{% if swift_backend is defined and swift_backend == 'memory' %}
use = egg:swift#mem_object
{% elif swift_backend is defined and swift_backend == 'bs_fork' %}
use = egg:swift#bs_object
{% else %}
use = egg:swift#object
{% endif %}
{% if swift_backend is defined and swift_backend == 'bs_bind' %}
disk_chunk_size = {{ 1024 * 1024 }}
bluestore_capacity = {{ bluestore_capacity * 1024 * 1024 * 1024 }}
eventlet_tpool_num_threads = 64
{% endif %}

[object-replicator]

[object-updater]

[object-auditor]

[object-expirer]

[object-reconstructor]

[object-relinker]
