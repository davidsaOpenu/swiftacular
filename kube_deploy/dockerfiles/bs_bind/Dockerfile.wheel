FROM ubuntu:26.04 AS build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-apt \
        python3-pip \
        ca-certificates \
        curl \
        software-properties-common \
        build-essential \
        cmake \
        ninja-build \
        git \
        g++ \
        nasm \
        libsystemd-dev \
        libudev-dev \
        libblkid-dev \
        libkeyutils-dev \
        libaio-dev \
        libsnappy-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        zlib1g-dev \
        libcap-dev \
        liblua5.4-dev \
        uuid-dev \
        liblz4-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/
WORKDIR /root/build

# We split up the build into multiple sections in order to
# make use of dockers caching

COPY bluestore/pyproject.toml bluestore/CMakeLists.txt .
RUN uv sync -v || [ -d src/vendor/ceph/src/boost ]

COPY bluestore/src/injection/ src/injection/
RUN touch src/extension/.a
RUN uv build --wheel || [ -e build/ceph-prefix/src/ceph-stamp/ceph-done ]

COPY bluestore/src/bluestore/hook_apply.pth src/bluestore/
COPY bluestore/src/extension src/extension/
RUN uv build --wheel

COPY bluestore/src/bluestore src/bluestore
RUN uv build --wheel

# We copy the final wheel into an empty image to avoid uploading the source code to the registry
FROM scratch

COPY --from=build /root/build/dist /
