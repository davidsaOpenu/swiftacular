# Default Swiftacular probe environment
#
# This template documents the standard topology. generate_probe_env.sh
# dynamically discovers the runner, proxy, Swift configuration directory,
# and test credential file. Storage nodes, addresses, ports, the admin
# credential file, and the device directory use the defaults below.
# probe.env is generated locally and must not be committed.

PROBE_RUNNER=swift-package-cache-01
PROBE_RUNNER_GROUP=swiftclient

# generate_probe_env.sh replaces this with the consistent live profile value.
EXPECTED_SHARD_CONTAINER_THRESHOLD=50
SHARDING_AUTO_SHARD=true
SHARDING_ROWS_PER_SHARD=25
SHARDING_MINIMUM_SHARD_SIZE=10
SHARDING_SHRINK_THRESHOLD=10
SHARDING_SCANNER_BATCH_SIZE=10
SHARDING_CLEAVE_BATCH_SIZE=2

SWIFT_TEST_RC=/home/vagrant/testrc
SWIFT_ADMIN_RC=/home/vagrant/adminrc

SWIFT_PROXY_NODE=swift-proxy-01
SWIFT_PROXY_GROUP=proxy

SWIFT_STORAGE_1=swift-storage-01
SWIFT_STORAGE_2=swift-storage-02
SWIFT_STORAGE_3=swift-storage-03

SWIFT_STORAGE_1_IP=10.0.20.200
SWIFT_STORAGE_2_IP=10.0.20.201
SWIFT_STORAGE_3_IP=10.0.20.202

SWIFT_OBJECT_PORT=6000
SWIFT_CONTAINER_PORT=6001
SWIFT_ACCOUNT_PORT=6002

SWIFT_CONFIG_DIR=/etc/swift
SWIFT_DEVICE_DIR=/srv/node
